# ==============================================================================
# Smart Sales Forecasting System - Environment Configuration Template
# NOTE: This file is a template. Never commit real credentials, passwords, or keys.
# ==============================================================================

# Application Environment: 'development', 'test', or 'production'
ENVIRONMENT=development

# Application Secret Key (Used for JWT generation and verification)
# In production, this MUST be a secure, random string with at least 32 characters.
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# JWT Token Expiry in Minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection URL
# Local SQLite default: sqlite:///backend/sales_forecasting.db
# Production PostgreSQL example: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=sqlite:///backend/sales_forecasting.db

# Allowed CORS Origins (Comma-separated list of origins permitted to call the backend)
# In development: http://localhost:5173,http://127.0.0.1:5173
# In production: https://your-frontend-domain.com,https://your-preview-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API Key (Optional: enables Phase 6.4 AI Reasoning & Prescriptive Recommendations)
# If left empty, system automatically operates in deterministic fallback mode.
GEMINI_API_KEY=

# Gemini Model Identifier (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
